{
  "name": "game-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @studio/gomoku",
    "build:web": "npm run build -w @studio/gomoku -- --mode web",
    "build:yandex": "npm run build -w @studio/gomoku -- --mode yandex",
    "build:vk": "npm run build -w @studio/gomoku -- --mode vk",
    "build:all": "npm run build:web && npm run build:yandex && npm run build:vk",
    "pack:yandex": "node tools/pack.mjs gomoku yandex",
    "pack:vk": "node tools/pack.mjs gomoku vk",
    "build:dachnye-tainy:web": "npm run build -w @studio/dachnye-tainy -- --mode web",
    "build:dachnye-tainy:vk": "npm run build -w @studio/dachnye-tainy -- --mode vk",
    "pack:dachnye-tainy:vk": "node tools/pack.mjs dachnye-tainy vk",
    "dev:pograniche": "npm run dev -w @studio/pograniche",
    "build:pograniche:web": "npm run build -w @studio/pograniche -- --mode web",
    "build:pograniche:vk": "npm run build -w @studio/pograniche -- --mode vk",
    "pack:pograniche:vk": "node tools/pack.mjs pograniche vk",
    "build:sudoku:web": "npm run build -w @studio/sudoku -- --mode web",
    "build:sudoku:vk": "npm run build -w @studio/sudoku -- --mode vk",
    "pack:sudoku:vk": "node tools/pack.mjs sudoku vk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
