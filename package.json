{
  "name": "game-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @studio/gomoku",
    "build:web": "npm run build -w @studio/gomoku -- --mode web",
    "build:yandex": "npm run build -w @studio/gomoku -- --mode yandex",
    "build:vk": "npm run build -w @studio/gomoku -- --mode vk",
    "build:all": "npm run build:web && npm run build:yandex && npm run build:vk",
    "pack:yandex": "node tools/pack.mjs gomoku yandex",
    "pack:vk": "node tools/pack.mjs gomoku vk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
